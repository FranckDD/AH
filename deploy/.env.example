# MODELE du fichier d'environnement du serveur (deploy/.env).
# Ne JAMAIS committer le vrai fichier (deploy/.env est ignore par git) ni coller
# ses valeurs dans une conversation. Toutes les valeurs ci-dessous sont fictives.
# Lancer : docker compose --env-file deploy/.env -f deploy/docker-compose.prod.yml up -d

# --- Domaine et images ---
# Nom de domaine public, sans https:// ni slash final
DOMAIN=ah2.example.test
# Proprietaire GHCR des images ghcr.io/<GHCR_OWNER>/ah2-api et ah2-web (minuscules)
GHCR_OWNER=example-owner
# Etiquette de version des images a deployer (jamais "latest")
IMAGE_TAG=v0.0.0-example

# --- Base de donnees applicative (Postgres 17) ---
# Utilisateur applicatif (superutilisateur du conteneur db)
POSTGRES_USER=ah2
# Nom de la base
POSTGRES_DB=AH2
# Mot de passe de la base; generate with: openssl rand -hex 32  (hex: il entre dans une URL)
POSTGRES_PASSWORD=CHANGE_ME_fake_db_password_0000000000000000
# Mot de passe du role de replication powersync_repl; generate with: openssl rand -hex 32
POWERSYNC_REPL_PASSWORD=CHANGE_ME_fake_repl_password_00000000000000

# --- Redis ---
# Mot de passe Redis; generate with: openssl rand -hex 32  (hex: il entre dans une URL)
REDIS_PASSWORD=CHANGE_ME_fake_redis_password_0000000000000

# --- Authentification (JWT) ---
# Secret de signature des jetons; generate with: openssl rand -base64 32
JWT_SECRET=CHANGE_ME_fake_jwt_secret_base64_0000000000=
# Algorithme de signature (doit rester HS256 : PowerSync valide la meme cle)
JWT_ALGORITHM=HS256

# --- PowerSync ---
# Port interne du service PowerSync (jamais publie sur l'hote)
PS_PORT=8080
# Jeton d'administration de l'API PowerSync; generate with: openssl rand -base64 32
PS_ADMIN_TOKEN=CHANGE_ME_fake_ps_admin_token_00000000000=
# Stockage interne PowerSync (pg-storage) : utilisateur, base et mot de passe
PG_STORAGE_USER=powersync
PG_STORAGE_DB=powersync_storage
# generate with: openssl rand -hex 32  (hex: il entre dans une URL)
PG_STORAGE_PASSWORD=CHANGE_ME_fake_storage_password_00000000000

# --- Caddy / certificats HTTPS ---
# Adresse de contact pour Let's Encrypt
ACME_EMAIL=admin@example.test
# Autorite de certification. Production : laisser la ligne commentee. Tant que le
# DNS ne pointe pas sur le serveur, utiliser l'autorite de test (jamais vide) :
# ACME_CA=https://acme-staging-v02.api.letsencrypt.org/directory
# HSTS (Strict-Transport-Security). Laisser la ligne commentee (= max-age=0, aucun
# epinglage) pendant l'essai local et la phase autorite de test. Une fois le vrai
# certificat Let's Encrypt obtenu, la production met :
# HSTS_HEADER=max-age=31536000
# Vide = vrais certificats; "local_certs" = autorite interne (essai a blanc, DOMAIN=localhost)
CADDY_TLS_MODE=

# --- Reglages optionnels ---
# Nombre de processus gunicorn de l'API
WEB_CONCURRENCY=2
# Nombre de taches Celery en parallele
CELERY_CONCURRENCY=2

# --- Sauvegardes (tache 9) : voir docs/exploitation/sauvegardes.md ---
# Mot de passe du depot restic (chiffre TOUTES les sauvegardes). Sans lui, aucune restauration :
# a conserver dans le gestionnaire de mots de passe des deux responsables. generate with: openssl rand -base64 32
RESTIC_PASSWORD=CHANGE_ME_fake_restic_password_000000000000
# Dossier de l'HOTE qui contient le depot local (doit appartenir a l'uid 10001, mode 0700)
BACKUP_REPO_DIR=/srv/ah2-backups
# Horaires (5 champs cron, fuseau Africa/Douala). Export de la base : chaque heure a :07
BACKUP_HOURLY_CRON="7 * * * *"
# Sauvegarde complete (base + fichiers) : chaque nuit a 02:30
BACKUP_NIGHTLY_CRON="30 2 * * *"
# Envoi chez Hostinger : une fois par semaine, dimanche 04:30
BACKUP_OFFSITE_CRON="30 4 * * 0"
# Controle d'integrite : mercredi 05:15
BACKUP_VERIFY_CRON="15 5 * * 3"
# Retention locale : nombre d'exports horaires gardes, puis jours / semaines / mois (sauvegardes de nuit)
KEEP_HOURLY=48
KEEP_DAILY=14
KEEP_WEEKLY=8
KEEP_MONTHLY=6
# Acces SFTP Hostinger (port SSH de Hostinger : souvent 65002). Chemin RELATIF au dossier personnel.
BACKUP_SFTP_HOST=sftp.example.test
BACKUP_SFTP_USER=u000000000
BACKUP_SFTP_PATH=backups/ah2
BACKUP_SFTP_PORT=65002
# Cle privee et empreinte du serveur (fichiers du serveur, jamais dans git, jamais ici) :
#   deploy/secrets/backup_sftp_key (chown 10001, mode 600) et deploy/secrets/backup_known_hosts
# BACKUP_SFTP_KEY_FILE=./secrets/backup_sftp_key
# BACKUP_KNOWN_HOSTS_FILE=./secrets/backup_known_hosts

# --- Alertes e-mail (tache 10) : voir docs/exploitation/alertes-et-acces.md ---
# Reglages SMTP et destinataires : fichiers deploy/alerts/alerts.env et deploy/alerts/recipients.txt
# (modeles *.example, jamais dans git). Tout le reste est optionnel :
# ALERT_DISK_PCT=80
# ALERT_CHECK_OFFSITE=1
# ALERTS_CONFIG_DIR=./alerts
