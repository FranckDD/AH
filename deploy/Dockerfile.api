# syntax=docker/dockerfile:1
# Image unique pour l'API, le worker Celery et le planificateur (supercronic).
# Contexte de build : la racine du depot.
#   docker build -f deploy/Dockerfile.api -t ah2-api .
# Le fichier deploy/Dockerfile.api.dockerignore (liste blanche) est lu par BuildKit.

# --- Etape 1 : telechargement de supercronic (curl ne reste pas dans l'image finale)
FROM alpine:3.20 AS supercronic
ARG SUPERCRONIC_VERSION=v0.2.51
# sha256 publie dans la page de la release aptible/supercronic (digest de l'asset)
ARG SUPERCRONIC_SHA256=cc232108374e8e2b537045f2d5eaa1229f619db314c3ba6a14d38b35dc0aa123
RUN apk add --no-cache curl \
 && curl -fsSL -o /supercronic \
      "https://github.com/aptible/supercronic/releases/download/${SUPERCRONIC_VERSION}/supercronic-linux-amd64" \
 && echo "${SUPERCRONIC_SHA256}  /supercronic" | sha256sum -c - \
 && chmod 0755 /supercronic

# --- Etape 2 : image finale
FROM python:3.12-slim

ENV TZ=Africa/Douala \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PRODUCT_PHOTO_DIR=/app/storage/product_photos \
    CONSENT_STORAGE_DIR=/app/storage/toxico_consents

# WeasyPrint 68 : Pango, Cairo (via pangocairo), GDK-Pixbuf, libffi + polices.
# Les modeles PDF demandent Helvetica/Arial : fonts-liberation est metriquement
# compatible ; fonts-dejavu-core sert de repli (caracteres accentues).
# postgresql-client : psql pour scripts/init_prod_db.sh (python:3.12-slim n en contient pas).
RUN apt-get update \
 && apt-get install -y --no-install-recommends \
      tzdata postgresql-client \
      libpango-1.0-0 libpangoft2-1.0-0 libpangocairo-1.0-0 \
      libcairo2 libgdk-pixbuf-2.0-0 libffi8 shared-mime-info \
      fonts-liberation fonts-dejavu-core \
 && ln -snf /usr/share/zoneinfo/$TZ /etc/localtime && echo $TZ > /etc/timezone \
 && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY requirements-api.txt ./
# gunicorn n'est dans aucun fichier requirements (il n'etait que dans le Procfile) :
# pin explicite ici.
RUN pip install -r requirements-api.txt gunicorn==23.0.0

COPY --from=supercronic /supercronic /usr/local/bin/supercronic

# Cache des polices construit a l'image ; XDG_CACHE_HOME evite l'avertissement
# fontconfig pour l'utilisateur sans repertoire personnel.
ENV XDG_CACHE_HOME=/tmp/.cache
RUN fc-cache -f

RUN groupadd --gid 10001 ah2 \
 && useradd --uid 10001 --gid 10001 --no-create-home --shell /usr/sbin/nologin ah2 \
 && mkdir -p storage/product_photos storage/toxico_consents static/uploads \
 && chown -R 10001:10001 /app

COPY --chown=10001:10001 api_backend ./api_backend
COPY --chown=10001:10001 controller ./controller
COPY --chown=10001:10001 repositories ./repositories
COPY --chown=10001:10001 models ./models
COPY --chown=10001:10001 utils ./utils
COPY --chown=10001:10001 tasks ./tasks
COPY --chown=10001:10001 alembic ./alembic
COPY --chown=10001:10001 alembic.ini celery_app.py ./
COPY --chown=10001:10001 ci ./ci
COPY --chown=10001:10001 scripts ./scripts
COPY --chown=10001:10001 assets/logo_light.png assets/logo_dark.png assets/ahlogo.png ./assets/
COPY --chown=10001:10001 deploy/entrypoints ./deploy/entrypoints
COPY --chown=10001:10001 deploy/scheduler ./deploy/scheduler
COPY --chown=10001:10001 deploy/alerts ./deploy/alerts
# Etat des alertes (volume alerts_state : herite de ce proprietaire au premier montage).
RUN mkdir -p /var/lib/ah2-alerts && chown 10001:10001 /var/lib/ah2-alerts

RUN chmod 0755 deploy/entrypoints/*.sh

USER 10001:10001
EXPOSE 8000

# Pas de HEALTHCHECK dans l'image : /health repond HTTP 200 meme base injoignable.
# Le compose utilise deploy/entrypoints/healthcheck.sh (lit le JSON) sur le seul service api.

ENTRYPOINT ["/app/deploy/entrypoints/run.sh"]
CMD ["api"]
