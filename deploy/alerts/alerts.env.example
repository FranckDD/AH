# Reglages SMTP des alertes (modele). Copier en deploy/alerts/alerts.env (ignore par git),
# chmod 600, proprietaire uid 10001. Le mot de passe n'est QUE dans ce fichier.
# Valeurs a lire dans les reglages du compte e-mail du domaine chez Hostinger.
SMTP_HOST=smtp.hostinger.com
# 465 = SSL direct (SMTP_SECURITY=ssl) ; 587 = STARTTLS (SMTP_SECURITY=starttls)
SMTP_PORT=465
SMTP_SECURITY=ssl
SMTP_USER=alertes@example.test
SMTP_PASSWORD=CHANGE_ME_smtp_password
SMTP_FROM=alertes@example.test

# Seuils (optionnel, valeurs par defaut ci-dessous)
# ALERT_DISK_PCT=80
# ALERT_HOURLY_MAX_H=3
# ALERT_NIGHTLY_MAX_H=30
# ALERT_OFFSITE_MAX_H=216
# ALERT_CERT_DAYS=14
# ALERT_REMINDER_H=24
# ALERT_CHECK_OFFSITE=0   (mettre 0 tant que l'envoi Hostinger n'est pas configure)
