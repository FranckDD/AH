# Copier en .env (gitignore, comme le .env racine du projet) et renseigner
# les vraies valeurs. Ne jamais committer .env.

# Postgres source (donnees AH2 reelles) - meme base que api_backend/,
# mais atteinte depuis le conteneur Docker via host.docker.internal au
# lieu de localhost.
PS_DATA_SOURCE_URI=postgresql://postgres:CHANGEME@host.docker.internal:5432/AH2

# Postgres de stockage interne PowerSync (buckets), separe des donnees AH2.
PG_STORAGE_DATABASE_USER=powersync
PG_STORAGE_DATABASE_NAME=powersync_storage
PG_STORAGE_DATABASE_PASSWORD=CHANGEME
PG_STORAGE_DATABASE_PORT=5433
PS_STORAGE_SOURCE_URI=postgresql://powersync:CHANGEME@pg-storage:5433/powersync_storage

# Port d'ecoute de l'API PowerSync (exposee sur l'hote au meme port).
PS_PORT=18080

# Cle client_auth (HS256) - encodage base64url du JWT_SECRET applicatif
# reel (voir .env racine du projet), au format JWK "k" attendu par
# service.yaml. Generer avec :
#   printf '%s' "<JWT_SECRET>" | openssl base64 -A | tr '+/' '-_' | tr -d '='
PS_APP_HS256_SECRET=CHANGEME

# Jeton d'administration locale de l'API PowerSync (routes /api/*), pas lie
# a l'auth des utilisateurs finaux. Regenerer avec : openssl rand -hex 24
PS_ADMIN_TOKEN=CHANGEME
